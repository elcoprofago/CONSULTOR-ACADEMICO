<UserControl x:Class="ConsultorAcademicoGui.PerfCircle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="ImgNew"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetName="ImgOld"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.4"/>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <Grid x:Name="CircleGrid" Width="48" Height="48">
            <Image x:Name="ImgOld" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" Opacity="0"/>
            <Image x:Name="ImgNew" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" Opacity="1"/>
            <Image x:Name="ImgMarco" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock x:Name="TxtMetric"
                   Text="-- 0%"
                   Width="64"
                   HorizontalAlignment="Center"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="White"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
    </StackPanel>
</UserControl>
