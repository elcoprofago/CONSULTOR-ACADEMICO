<Window x:Class="ConsultorAcademicoGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ConsultorAcademicoGui"
        Title="CONSULTOR-ACADEMICO-GUI" Height="950" Width="1500"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Background="#FF1A1A1A"
        Closing="Window_Closing">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== FILA 0: búsqueda + círculos ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="BorderBusqueda" Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderThickness="0"
                    CornerRadius="4" Padding="12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Búsqueda" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPregunta" Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                                 ToolTip="Frase exacta entre comillas, o pregunta en lenguaje natural"
                                 KeyDown="TxtPregunta_KeyDown"/>
                        <ToggleButton x:Name="BtnHistorialToggle" Grid.Column="1" Width="30" Height="30"
                                      Margin="6,0,0,0" FontSize="14" Content="🕘"
                                      ToolTip="Búsquedas recientes"/>
                        <Popup x:Name="PopupHistorial" PlacementTarget="{Binding ElementName=TxtPregunta}"
                               Placement="Bottom" StaysOpen="False"
                               Width="{Binding ActualWidth, ElementName=TxtPregunta}"
                               IsOpen="{Binding IsChecked, ElementName=BtnHistorialToggle, Mode=TwoWay}">
                            <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1">
                                <ItemsControl x:Name="ListHistorial">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="White" Padding="8,5"
                                                       TextTrimming="CharacterEllipsis" Cursor="Hand"
                                                       MouseLeftButtonUp="HistorialItem_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,14,0">
                            <TextBlock Text="Documentos" Foreground="{StaticResource TextDim}" FontSize="11"/>
                            <ToggleButton x:Name="BtnFiltroToggle" Width="220" Height="28"
                                          HorizontalContentAlignment="Left" Padding="6,0"
                                          Background="#FF181818" Foreground="{StaticResource TextMain}"
                                          BorderBrush="{StaticResource PanelBorder}"
                                          Content="(todos)"/>
                            <Popup x:Name="PopupFiltro" PlacementTarget="{Binding ElementName=BtnFiltroToggle}"
                                   Placement="Bottom" StaysOpen="False"
                                   Width="{Binding ActualWidth, ElementName=TxtPregunta}"
                                   IsOpen="{Binding IsChecked, ElementName=BtnFiltroToggle, Mode=TwoWay}">
                                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                        <ItemsControl x:Name="ListFiltro">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Foreground="White" FontWeight="SemiBold"
                                                                  ToolTip="{Binding Label}"
                                                                  Checked="FiltroCheckBox_Changed" Unchecked="FiltroCheckBox_Changed">
                                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                        </CheckBox>
                                                        <Button Grid.Column="1" Content="Cita" FontSize="10" Padding="4,0"
                                                                ToolTip="Copiar cita (APA) de este documento: la de su ficha de CitaPDF si tiene una"
                                                                Click="FiltroCopiarCita_Click"/>
                                                        <Button Grid.Column="2" Content="PDF" FontSize="10" Padding="4,0" Margin="4,0,0,0"
                                                                ToolTip="Abrir el PDF original (o ubicarlo si se movió)"
                                                                Click="FiltroAbrirPdf_Click"/>
                                                        <Button Grid.Column="3" Content="Ficha" FontSize="10" Padding="4,0" Margin="4,0,0,0"
                                                                ToolTip="Ficha del catálogo de CitaPDF (ver, vincular)"
                                                                Click="FiltroFicha_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,14,0">
                            <TextBlock Text="K (resultados)" Foreground="{StaticResource TextDim}" FontSize="11"/>
                            <TextBox x:Name="TxtK" Width="60" Text="5" Height="28" VerticalContentAlignment="Center"
                                     PreviewTextInput="TxtK_PreviewTextInput"/>
                        </StackPanel>

                        <Border Grid.Column="3" Width="1" Background="{StaticResource PanelBorder}" Margin="0,4,14,4"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="BtnAgregarMaterial" Content="Agregar material" Click="BtnAgregarMaterial_Click" Height="28"/>
                            <Button x:Name="BtnConsultar" Content="Consultar" Click="BtnConsultar_Click"
                                    Style="{StaticResource ConsultarButtonStyle}" Height="28" Margin="10,0,0,0"/>
                            <Button x:Name="BtnLimpiarResultados" Content="Limpiar resultados"
                                    Click="BtnLimpiarResultados_Click" Height="28"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="BorderPerf" Grid.Column="1" Background="{StaticResource PanelBg}"
                    BorderThickness="0"
                    CornerRadius="4" Padding="10">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical" Margin="6,0">
                        <TextBlock Text="RAM" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <local:PerfCircle x:Name="CircleRam"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="6,0">
                        <TextBlock Text="CPU" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <local:PerfCircle x:Name="CircleCpu"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="6,0">
                        <TextBlock Text="GPU" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <local:PerfCircle x:Name="CircleGpu"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== FILA 1: resultados + log ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition x:Name="ColSplitterLog" Width="6"/>
                <ColumnDefinition x:Name="ColLog" Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderThickness="0" CornerRadius="4">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="Resultados" Style="{StaticResource SectionHeader}"/>

                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnAnterior" Content="◀ Anterior" Click="BtnAnterior_Click"/>
                        <TextBlock Grid.Column="1" x:Name="TxtContador" Text="" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                        <Button Grid.Column="2" x:Name="BtnSiguiente" Content="Siguiente ▶" Click="BtnSiguiente_Click"/>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FFF2EDE1">
                        <StackPanel x:Name="PanelResultados"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SplitterLog" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{StaticResource PanelBorder}"/>

            <Border x:Name="BorderLog" Grid.Column="2" Background="#FF1E1E1E"
                    BorderThickness="0" CornerRadius="4">
                <DockPanel x:Name="PanelLog" Margin="12">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Log" Style="{StaticResource SectionHeader}"/>
                        <Button x:Name="BtnToggleLog" DockPanel.Dock="Left" Content="▼" Margin="8,0,0,0"
                                Style="{StaticResource SectionToggleButtonStyle}"
                                Click="BtnToggleLog_Click"
                                ToolTip="Ocultar/mostrar panel de Log"/>
                        <Button x:Name="BtnDesacoplarLog" DockPanel.Dock="Right" Content="Desacoplar"
                                FontSize="11" Padding="6,1" VerticalAlignment="Center"
                                Click="BtnDesacoplarLog_Click"
                                ToolTip="Pasar el Log a una ventana aparte (por ejemplo, en otro monitor). Al cerrarla vuelve aquí."/>
                    </DockPanel>
                    <RichTextBox x:Name="TxtLog" DockPanel.Dock="Top"
                                 Background="#FF1E1E1E" Foreground="White"
                                 BorderThickness="0" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===================== FILA 2: botones de control ===================== -->
        <Border x:Name="BorderBotones" Grid.Row="2" Background="{StaticResource PanelBg}"
                BorderThickness="0"
                CornerRadius="4" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnIniciarLlama" Content="Iniciar llama-server" Click="BtnIniciarLlama_Click"/>
                    <Button x:Name="BtnPurgar" Content="Purgar procesos huérfanos" Click="BtnPurgar_Click"
                            ToolTip="Mata (con todo su árbol de procesos) cualquier backend/llama-server que haya quedado corriendo de una instancia anterior de CONSULTOR-ACADEMICO-GUI"/>

                    <Border Width="1" Background="{StaticResource PanelBorder}" Margin="6,2"/>

                    <RadioButton x:Name="RbVistaActual" Content="Exportar: vista actual" GroupName="Export" IsChecked="True" Margin="12,0,10,0"/>
                    <RadioButton x:Name="RbVistaTodos" Content="todos" GroupName="Export"/>
                    <Button x:Name="BtnExportar" Content="Exportar resultados" Click="BtnExportar_Click" Margin="10,0,0,0"/>

                    <Border Width="1" Background="{StaticResource PanelBorder}" Margin="12,2"/>

                    <Button x:Name="BtnGuardarSesion" Content="Guardar sesión" Click="BtnGuardarSesion_Click" Margin="6,0,10,0"/>
                    <Button x:Name="BtnCargarSesion" Content="Cargar sesión" Click="BtnCargarSesion_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnActualizar" Content="Actualizar" Click="BtnActualizar_Click"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTip="Buscar en GitHub una versión nueva del programa e instalarla (solo cambia app\; tus datos y modelos no se tocan)"/>
                    <Button x:Name="BtnConfiguracion" Width="40" Height="40" Padding="6"
                            Margin="10,0,0,0"
                            Click="BtnConfiguracion_Click" ToolTip="Configuración">
                        <Image x:Name="ImgConfiguracion" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
