<Window x:Class="ConsultorAcademicoGui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Height="620" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1A1A1A">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- ===================== Fondo de ventana ===================== -->
            <TextBlock Text="Fondo de ventana" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}"
                    BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbTemaClaro" Content="Blanco" GroupName="Tema" Checked="Tema_Changed"/>
                        <RadioButton x:Name="RbTemaOscuro" Content="Oscuro" GroupName="Tema" Checked="Tema_Changed"/>
                        <RadioButton x:Name="RbTemaTextura" Content="Con textura" GroupName="Tema" Checked="Tema_Changed"/>
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtRutaTextura" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="BtnExaminarTextura" Grid.Column="1" Content="Examinar..."
                                Click="BtnExaminarTextura_Click"/>
                    </Grid>
                    <TextBlock Text="Imagen (o, si no se elige ninguna, un color liso) usada como fondo de la ventana y de los paneles de búsqueda, rendimiento y botones. Los paneles de Resultados y Log quedan siempre opacos, por legibilidad del texto."
                               Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===================== Exportación ===================== -->
            <TextBlock Text="Exportación" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}"
                    BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Formato de exportación" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <ComboBox x:Name="CmbFormatoExportacion" Width="140" HorizontalAlignment="Left" Margin="0,2,0,10">
                        <ComboBoxItem Content="docx"/>
                        <ComboBoxItem Content="pdf"/>
                        <ComboBoxItem Content="txt"/>
                    </ComboBox>

                    <TextBlock Text="Carpeta de destino por defecto" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCarpetaExportacion" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="BtnExaminarCarpeta" Grid.Column="1" Content="Examinar..."
                                Click="BtnExaminarCarpeta_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== Biblioteca ===================== -->
            <TextBlock Text="Biblioteca" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}"
                    BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Carpeta de la biblioteca (PDF)" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCarpetaBiblioteca" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Examinar..." Click="BtnExaminarBiblioteca_Click"/>
                        <Button Grid.Column="2" Content="Automática" Margin="8,0,0,0" Click="BtnBibliotecaAutomatica_Click"
                                ToolTip="En la versión portable: la carpeta BASE de la unidad desde la que arranca"/>
                    </Grid>
                    <TextBlock x:Name="LblEstadoBiblioteca" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,14"/>

                    <TextBlock Text="Carpeta de descargas" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCarpetaDescargas" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="BtnExaminarDescargas" Grid.Column="1" Content="Examinar..."
                                Click="BtnExaminarDescargas_Click"/>
                    </Grid>
                    <TextBlock Text="Donde se guarda el PDF del material agregado por URL. El consultor no copia los PDFs: indexa cada uno desde donde está y recuerda su ruta."
                               Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <TextBlock Text="Catálogo de CitaPDF (biblioteca.json)" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,14,0,0"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCatalogoCitaPdf" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Examinar..." Click="BtnExaminarCatalogo_Click"/>
                        <Button Grid.Column="2" Content="Por defecto" Margin="8,0,0,0" Click="BtnCatalogoPorDefecto_Click"
                                ToolTip="Usar el catálogo de CitaPDF instalado (Documentos\CitaPDF\biblioteca.json)"/>
                    </Grid>
                    <TextBlock x:Name="LblEstadoCatalogo" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="De ahí salen las fichas adjuntas a cada documento. El consultor solo lo lee: nunca lo modifica. Con CitaPDF portable, elegí el biblioteca.json de su carpeta datos."
                               Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===================== Modelos ===================== -->
            <TextBlock Text="Modelos" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}"
                    BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Carpeta de modelos" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtCarpetaModelos" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Examinar..." Click="BtnExaminarModelos_Click"/>
                        <Button Grid.Column="2" Content="Automática" Margin="8,0,0,0" Click="BtnModelosAutomatica_Click"
                                ToolTip="Sólo las carpetas de siempre (Models\ de la app y MODELS\ de la unidad)"/>
                    </Grid>
                    <TextBlock x:Name="LblEstadoModelos" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===================== Búsqueda ===================== -->
            <TextBlock Text="Búsqueda" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}"
                    BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="ChkUsarGpu" Content="Acelerar búsqueda por GPU"/>
                    <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10"
                               Text="Mueve a GPU sólo el cálculo del embedding de la consulta (rápido de por sí); la búsqueda en el índice FAISS y la selección de diversidad (MMR), que son el costo real de cada consulta, siguen en CPU porque la instalación de FAISS de este equipo no tiene soporte GPU. Requiere reiniciar la app para tomar efecto."/>

                    <TextBlock Text="K (resultados) por defecto" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <TextBox x:Name="TxtKDefault" Width="80" HorizontalAlignment="Left" Margin="0,2,0,10"/>

                    <TextBlock Text="Diversidad de contexto (MMR) por defecto" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderMmr" Grid.Column="0" Minimum="0" Maximum="1" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" ValueChanged="SliderMmr_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblMmr" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="0 = priorizar variedad de ángulos, 1 = priorizar pura similitud con la pregunta. Requiere reiniciar la app para tomar efecto."/>
                </StackPanel>
            </Border>

            <!-- ===================== Interfaz ===================== -->
            <TextBlock Text="Interfaz" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}"
                    BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Tamaño de fuente del panel de resultados" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SliderFuente" Grid.Column="0" Minimum="10" Maximum="22" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="SliderFuente_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LblFuente" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== General ===================== -->
            <TextBlock Text="General" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}"
                    BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <CheckBox x:Name="ChkAutoPurgar" Content="Purgar procesos huérfanos automáticamente al cerrar la app"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="BtnCancelar" Content="Cancelar" Click="BtnCancelar_Click"/>
                <Button x:Name="BtnGuardar" Content="Guardar" Click="BtnGuardar_Click" Style="{StaticResource ConsultarButtonStyle}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
