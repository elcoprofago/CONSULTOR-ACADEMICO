<Window x:Class="ConsultorAcademicoGui.UbicarPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ubicar PDF" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        Background="#FF1A1A1A">
    <StackPanel Margin="14">
        <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="BtnUsarRuta" DockPanel.Dock="Right" Content="Usar esta ruta"
                    Margin="8,0,0,0" VerticalAlignment="Top" Click="BtnUsarRuta_Click"/>
            <TextBox x:Name="TxtRuta" TextWrapping="Wrap" KeyDown="TxtRuta_KeyDown"/>
        </DockPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,10"
                   Text="Podés corregir la ruta a mano (por ejemplo, si cambió la letra de la unidad). El PDF se reconoce por su contenido, no por el nombre: al buscar en una carpeta se encuentra aunque lo hayas renombrado, se revisan sus subcarpetas, y se aprovecha para encontrar los demás PDFs de la biblioteca que falten. Sólo se acepta el mismo archivo que se indexó: otra edición tendría otras páginas que las de las citas."/>
        <TextBlock x:Name="TxtProgreso" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
        <DockPanel>
            <Button x:Name="BtnCopiaInterna" DockPanel.Dock="Left" Content="Abrir copia interna" Visibility="Collapsed"
                    ToolTip="Abre la copia que el consultor guardaba en ACADEMICO-PDF antes de dejar de copiar PDFs"
                    Click="BtnCopiaInterna_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnElegir" Content="Elegir el archivo..." Click="BtnElegir_Click"/>
                <Button x:Name="BtnBuscar" Content="Buscar en una carpeta..." Margin="8,0,0,0" Click="BtnBuscar_Click"/>
                <Button x:Name="BtnCancelar" Content="Cancelar" Margin="8,0,0,0" Click="BtnCancelar_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
