<Window x:Class="ConsultorAcademicoGui.AgregarMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar material" Height="700" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1A1A1A">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <TextBlock Text="Ficha de CitaPDF (opcional)" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}" BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="BtnQuitarFicha" DockPanel.Dock="Right" Content="Quitar" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="BtnQuitarFicha_Click"/>
                        <Button x:Name="BtnDesdeCatalogo" Content="Desde el catálogo de CitaPDF..."
                                HorizontalAlignment="Left" Click="BtnDesdeCatalogo_Click"/>
                    </DockPanel>
                    <TextBlock x:Name="LblFicha" Foreground="{StaticResource TextDim}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Elegir un registro del catálogo completa los datos y el origen, y deja la ficha adjunta al documento."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Origen" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}" BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbOrigenArchivo" Content="Archivo local" GroupName="Origen"
                                     IsChecked="True" Checked="RbOrigen_Changed" Margin="0,0,16,0"/>
                        <RadioButton x:Name="RbOrigenUrl" Content="URL de descarga directa" GroupName="Origen"
                                     Checked="RbOrigen_Changed"/>
                    </StackPanel>

                    <Grid x:Name="PanelArchivo">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtArchivo" Grid.Column="0" IsReadOnly="True"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="BtnExaminarArchivo" Grid.Column="1" Content="Examinar..."
                                Click="BtnExaminarArchivo_Click"/>
                    </Grid>

                    <TextBox x:Name="TxtUrl" Visibility="Collapsed" VerticalContentAlignment="Center"
                             ToolTip="URL que responda directamente el PDF (no una página HTML que lo enlace)"
                             TextChanged="Campo_Changed"/>

                    <TextBlock x:Name="LblNotaOrigen" Foreground="{StaticResource TextDim}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Datos del documento" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource PanelBg}" BorderThickness="0" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Título (obligatorio)" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <TextBox x:Name="TxtTitulo" Margin="0,2,0,10" TextChanged="Campo_Changed"/>

                    <TextBlock Text="Autor" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <TextBox x:Name="TxtAutor" Margin="0,2,0,10"/>

                    <TextBlock Text="Año" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <TextBox x:Name="TxtAnio" Width="120" HorizontalAlignment="Left" Margin="0,2,0,10"/>

                    <TextBlock Text="Fuente / editorial" Foreground="{StaticResource TextDim}" FontSize="11"/>
                    <TextBox x:Name="TxtFuente" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="BtnCerrar" Content="Cerrar" Click="BtnCerrar_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnAgregar" Content="Agregar" Click="BtnAgregar_Click"
                        Style="{StaticResource ConsultarButtonStyle}" IsEnabled="False"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
