<Window x:Class="ConsultorAcademicoGui.CatalogoCitaPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catálogo de CitaPDF" Width="720" Height="560"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown"
        Background="#FF1A1A1A">
    <DockPanel Margin="14">
        <TextBlock x:Name="TxtMensaje" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtBuscar" TextChanged="TxtBuscar_TextChanged" VerticalContentAlignment="Center" Height="26"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="TxtCatalogo" DockPanel.Dock="Left" Foreground="{StaticResource TextDim}" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnElegir" Content="Elegir" IsEnabled="False" Click="BtnElegir_Click"
                        Style="{StaticResource ConsultarButtonStyle}"/>
                <Button Content="Cancelar" Margin="8,0,0,0" Click="BtnCancelar_Click"/>
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="ListFichas" Background="#FF181818" BorderBrush="{StaticResource PanelBorder}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="ListFichas_SelectionChanged" MouseDoubleClick="ListFichas_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock TextWrapping="Wrap" Foreground="White" FontWeight="SemiBold">
                            <Run Text="{Binding Ficha.DocumentoId, Mode=OneWay}" Foreground="#FF8FB8DE"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Ficha.Titulo, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11"/>
                        <TextBlock Text="{Binding Aviso}" Foreground="#FFE0B050" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
